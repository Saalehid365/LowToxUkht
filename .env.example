# Neon Postgres connection string (Neon dashboard → Connect → copy the connection string)
# Leave empty during local testing: submissions are saved to .data/submissions.json instead.
DATABASE_URL=

# Password for the /admin dashboard. Leave empty for no password (anyone with the link can see submissions).
ADMIN_PASSWORD=change-me-to-something-long

# Your Calendly event link, e.g. https://calendly.com/your-name/consultation
NEXT_PUBLIC_CALENDLY_URL=

# Email for new intake forms (https://resend.com → API Keys). The PDF is attached.
RESEND_API_KEY=
# Where intake emails are sent
INTAKE_EMAIL_TO=
# Sender. Until you verify your own domain in Resend, keep onboarding@resend.dev
# (Resend then only delivers to the email address you signed up to Resend with).
INTAKE_EMAIL_FROM=Intake forms <onboarding@resend.dev>
# Your live site address, used for the dashboard link in emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
